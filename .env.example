# ReplyPilot environment variables (all optional — the app runs with mock data).
# Copy to `.env.local` to override. Client-exposed values must use the VITE_ prefix.

# Product name shown in the UI.
VITE_APP_NAME=ReplyPilot

# Base URL for a real backend (unused by the mock API). Leave blank for the demo.
VITE_API_BASE_URL=
