# ReplyPilot environment variables.
# Copy to `.env.local` for local dev. Client-exposed values use the NEXT_PUBLIC_
# prefix; everything else is SERVER-ONLY (read by route handlers, never the browser).

# ──────────────────────────────────────────────────────────────────────────
# Front-end (client-exposed) — optional. The app runs with mock data.
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ReplyPilot
NEXT_PUBLIC_API_BASE_URL=

# ──────────────────────────────────────────────────────────────────────────
# Review integration layer (SERVER-ONLY)
# ──────────────────────────────────────────────────────────────────────────

# Active provider: "mock" (default, no creds needed) | "postproxy".
REVIEW_PROVIDER=mock

# Ingestion mode: "poll" (default) | "webhook" | "both".
# poll is always available as a safety net; webhook needs a paid Postproxy tier.
INGEST_MODE=poll

# Recommended: secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Optional. If set, the poll route rejects requests without it.
CRON_SECRET=

# ── Database (Vercel Postgres / Neon) ──
POSTGRES_URL=               # REQUIRED for db:push — from Vercel Storage or `vercel env pull`

# ── Admin (TESTING ONLY) ──
# Required by GET /api/admin/reset-ledger?secret=... to clear the processed_ledger table.
ADMIN_SECRET=

# ── Postproxy ──  Required when REVIEW_PROVIDER=postproxy (poll mode):
POSTPROXY_API_KEY=            # REQUIRED for postproxy — from the Postproxy dashboard
POSTPROXY_PROFILE_ID=         # REQUIRED for postproxy — the connected google_business profile id (prof_...)
POSTPROXY_PLACEMENT_ID=       # REQUIRED for postproxy — location scope, e.g. accounts/123/locations/456

# Required ONLY when INGEST_MODE=webhook or both:
POSTPROXY_WEBHOOK_SECRET=     # REQUIRED for webhook mode — the whsec_... from webhook creation

# Optional Postproxy tuning (sensible defaults applied):
POSTPROXY_API_BASE_URL=https://api.postproxy.dev   # optional — override base URL
POSTPROXY_WEBHOOK_TOLERANCE_SECONDS=300            # optional — reject stale signatures
POSTPROXY_MAX_POLL_PAGES=5                          # optional — pages fetched per poll run
POSTPROXY_PER_PAGE=50                               # optional — page size when listing
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RESEND_API_KEY=your_resend_api_key_here
NOTIFICATION_EMAIL=your_email_here
POSTGRES_URL=your_postgres_url_here